# Supabase (Project Settings > Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Web app base URL (used in invite / password reset / unsubscribe / briefing links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Resend (https://resend.com/api-keys) — daily briefing & approved marketing campaigns
RESEND_API_KEY=
RESEND_FROM_EMAIL=히포티앤씨 일일뉴스수집기 <briefing@hippotnc.com>

# Vercel Cron security token (random 32+ char string; Vercel automatically sends Bearer header)
CRON_SECRET=
